generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password_hash String
  nim           String    @unique
  full_name     String
  role          String    @default("member") // 'admin', 'instructor', 'member'
  status        String    @default("pending") // 'pending', 'active', 'blocked'
  avatar_url    String?
  bio           String?
  phone         String?
  program_studi String?
  angkatan      Int?
  points        Int       @default(0)
  streak_days   Int       @default(0)
  last_active_at DateTime?
  // B-5: token JWT stateless 30 hari tidak otomatis batal saat password diganti.
  // Simpan waktu perubahan password; authenticate menolak token yang diterbitkan
  // sebelum timestamp ini (bandingkan iat JWT dengan kolom ini).
  password_changed_at DateTime?
  reset_token   String?   @unique
  reset_token_expiry DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  classesTaught Class[]      @relation("InstructorClasses")
  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]
  pointTransactions PointTransaction[]
  notifications Notification[]
  badges        UserBadge[]
}

model Class {
  id          String       @id @default(uuid())
  name        String
  description String?
  instructorId String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  instructor  User         @relation("InstructorClasses", fields: [instructorId], references: [id])
  enrollments Enrollment[]
  materials   Material[]
  quizzes     Quiz[]
}

model Enrollment {
  id            String    @id @default(uuid())
  userId        String
  classId       String
  joined_at     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  class         Class     @relation(fields: [classId], references: [id])

  @@unique([userId, classId])
  @@index([classId])
}

model Material {
  id            String    @id @default(uuid())
  classId       String
  title         String
  url           String
  type          String    @default("link") // 'video', 'pdf', 'link'
  created_at    DateTime  @default(now())

  class         Class     @relation(fields: [classId], references: [id])

  @@index([classId])
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  classId     String
  max_attempts Int?    // null = unlimited, default 3 diterapkan di controller untuk quiz baru
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  class       Class    @relation(fields: [classId], references: [id])
  questions   Question[]
  attempts    QuizAttempt[]

  @@index([classId])
}

model Question {
  id             String   @id @default(uuid())
  quizId         String
  question_text  String
  options        String   // JSON stringified array of options: ["A", "B", "C", "D"]
  correct_answer String   // The correct option
  created_at     DateTime @default(now())

  quiz           Quiz     @relation(fields: [quizId], references: [id])

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int      // 0 to 100
  created_at  DateTime @default(now())

  quiz        Quiz     @relation(fields: [quizId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([quizId, userId])
}

model PointTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // 'enroll', 'quiz', 'login', 'admin'
  amount      Int      // positif = gain, negatif = deduction
  description String
  created_at  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, created_at])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // 'account_approved', 'account_blocked', 'new_material', 'new_quiz', 'badge_earned'
  message     String
  link        String?
  read        Boolean  @default(false)
  created_at  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, read, created_at])
}

model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  badgeKey    String   // e.g. 'streak-7', 'quiz-master', 'class-collector', 'top-10'
  earned_at   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeKey])
}
