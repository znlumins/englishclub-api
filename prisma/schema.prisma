generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password_hash String
  nim           String    @unique
  full_name     String
  role          String    @default("member") // 'admin', 'mentor', 'member'
  status        String    @default("pending") // 'pending', 'active', 'blocked'
  avatar_url    String?
  bio           String?
  phone         String?
  program_studi String?
  angkatan      Int?
  points        Int       @default(0)
  streak_days   Int       @default(0)
  last_active_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  classesTaught Class[]      @relation("InstructorClasses")
  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]
}

model Class {
  id          String       @id @default(uuid())
  name        String
  description String?
  instructorId String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  instructor  User         @relation("InstructorClasses", fields: [instructorId], references: [id])
  enrollments Enrollment[]
  materials   Material[]
  quizzes     Quiz[]
}

model Enrollment {
  id            String    @id @default(uuid())
  userId        String
  classId       String
  joined_at     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  class         Class     @relation(fields: [classId], references: [id])

  @@unique([userId, classId])
}

model Material {
  id            String    @id @default(uuid())
  classId       String
  title         String
  url           String
  type          String    @default("link") // 'video', 'pdf', 'link'
  created_at    DateTime  @default(now())

  class         Class     @relation(fields: [classId], references: [id])
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  classId     String
  created_at  DateTime @default(now())

  class       Class    @relation(fields: [classId], references: [id])
  questions   Question[]
  attempts    QuizAttempt[]
}

model Question {
  id             String   @id @default(uuid())
  quizId         String
  question_text  String
  options        String   // JSON stringified array of options: ["A", "B", "C", "D"]
  correct_answer String   // The correct option
  created_at     DateTime @default(now())

  quiz           Quiz     @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int      // 0 to 100
  created_at  DateTime @default(now())

  quiz        Quiz     @relation(fields: [quizId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}
