# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
DATABASE_URL="mysql://root:password@localhost:3306/lso_vokasi_ub?charset=utf8mb4"

# JWT secret key — generate a strong random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-key-change-this-in-production"

# Server port (default: 3000)
PORT=3000

# URL frontend resmi. Dipakai untuk:
#  - whitelist CORS (B-17)
#  - membangun link reset password (B-1) — JANGAN biarkan backend membaca header Host,
#    karena attacker bisa memalsukannya untuk membocorkan token reset.
# Production: https://englishclub-vokasi.id (atau domain frontend kamu)
FRONTEND_URL=http://localhost:3000

# SMTP (opsional) — untuk kirim email reset password sungguhan.
# Kalau SMTP_HOST/SMTP_USER/SMTP_PASS tidak diisi, reset link cuma di-log ke console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
